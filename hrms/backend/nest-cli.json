{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "/roles/seed-data",
        "outDir": "dist/",
        "watchAssets": true
      },
      {
        "include": "/email/templates",
        "outDir": "dist/",
        "watchAssets": true
      }
    ],
    "deleteOutDir": true
  },
  "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
}
